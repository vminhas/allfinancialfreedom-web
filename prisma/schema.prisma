enum NewBusinessStatus {
  PENDING
  ISSUED
  DECLINED
  LAPSED
  NOT_TAKEN
  // Application paused (waiting on client info, underwriting, etc.).
  // Added for the LC SOP, which tracks a "Hold" state distinct from
  // Pending. The SOP's "New" maps to PENDING (the initial state).
  HOLD
  // Application submitted to the carrier and awaiting a decision. The
  // SOP separates "New" (freshly logged, = PENDING, the default + what
  // the claim/stats flow keys on) from "Pending" (actively at the
  // carrier). This is that distinct "Pending" state, set manually by
  // the LC; the default stays PENDING so nothing downstream changes.
  PENDING_CARRIER
  CONDITIONALLY_ISSUED
}

