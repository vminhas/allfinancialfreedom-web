generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // AES-256 encrypted for sensitive keys
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  assignedRequests CoordinatorRequest[] @relation("AssignedCoordinator")
  authoredLicensingNotes LicensingNote[]
  assignedSubmissions NewBusinessSubmission[] @relation("AssignedSubmissions")
  authoredSubmissionNotes NewBusinessNote[] @relation("SubmissionNoteAdmin")
  submissionActivity NewBusinessSubmissionActivity[] @relation("SubmissionActivityAdmin")
  renewalRemindersSent RenewalReminder[] @relation("RenewalRemindersSent")
  reviewedMilestones   RecognitionMilestone[] @relation("MilestoneReviewer")
  callReviews          AdminCallReview[]
  authoredFeedbackNotes AgentFeedbackNote[]

  @@map("admin_users")
}

// Standalone coaching-tool reviews authored by an admin against a
// pasted transcript. Separate from CallReview (which is tied to an
// agent's CallLog) because admin self-reviews don't have a CallLog
// row. Lets each admin track their own progress over time on the
// same 6-dimension AFF rubric the agents are scored against.
model AdminCallReview {
  id                 String     @id @default(cuid())
  adminUserId        String
  adminUser          AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  // Free-form context the admin entered before running the analysis.
  // contactName is optional (helps Claude frame the review); callDate
  // is required so the history list has something to sort/filter on.
  contactName        String?
  callDate           DateTime
  // Full transcript saved so the admin can re-read it later or run a
  // re-analysis with a tweaked prompt without having to keep the
  // text around in their notes app.
  callTranscript     String     @db.Text

  overallScore       Int
  rubricScores       Json
  strengths          Json
  weaknesses         Json
  coachingTips       Json
  nextSteps          Json
  summary            String

  // Free-form note the admin can add after the fact (e.g. "tried the
  // tip on the next call, worked great").
  notes              String?

  modelId            String
  inputTokens        Int
  outputTokens       Int
  cacheReadTokens    Int        @default(0)
  cacheCreateTokens  Int        @default(0)
  reviewedAt         DateTime   @default(now())

  @@index([adminUserId, reviewedAt])
  @@index([reviewedAt])
  @@map("admin_call_reviews")
}

enum AdminRole {
  ADMIN
  LICENSING_COORDINATOR
}

// Audit log of sign-in attempts. Only rejected attempts are logged
// (successful sign-ins are tracked via AdminUser.lastLoginAt /
// AgentUser.lastLoginAt). Lets admins answer "did anyone try to get
// in who shouldn't have?" without trawling Vercel logs.
//
// Triggered today by the Google OAuth signIn callback when the email
// doesn't match an AdminUser or active AgentUser. Credentials-path
// failures (wrong password) are not logged here yet - those don't
// indicate someone trying to bypass approval, just a typo.
model SignInAttempt {
  id        String   @id @default(cuid())
  email     String
  provider  String   // 'google' for now
  outcome   String   // 'rejected_unknown_email' | 'rejected_inactive_agent'
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
  @@map("sign_in_attempts")
}

model ImportJob {
  id              String    @id @default(cuid())
  fileName        String
  totalRows       Int       @default(0)
  importedCount   Int       @default(0)
  skippedCount    Int       @default(0)
  errorCount      Int       @default(0)
  lastRowIndex    Int       @default(0)
  status          ImportJobStatus @default(PENDING)
  contextPrompt   String?
  wornOutStrategy String?   // "flag_column" | "manual" | "none"
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  contacts        Contact[]

  @@map("import_jobs")
}

enum ImportJobStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETE
  ERROR
}

model Contact {
  id             String    @id @default(cuid())
  ghlContactId   String?   @unique
  firstName      String
  lastName       String
  email          String    @unique
  phone          String?
  licenseType    String?   // "life" | "health" | "p&c" | "variable" | "multiple"
  currentAgency  String?
  state          String?
  source         String    @default("prophog")
  wornOut        Boolean   @default(false)
  outreachStatus String?   // "pending" | "drafted" | "sent" | "responded" | "opted-out"
  importJobId    String?
  importJob      ImportJob? @relation(fields: [importJobId], references: [id])
  messages       OutreachMessage[]
  createdAt      DateTime  @default(now())

  @@map("contacts")
}

model SuppressionEntry {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  reason    String?
  addedAt   DateTime @default(now())

  @@map("suppression_list")
}

model OutreachMessage {
  id           String    @id @default(cuid())
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id])
  subject      String
  bodyHtml     String
  status       MessageStatus @default(DRAFT)
  sentAt       DateTime?
  ghlMessageId String?
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  createdAt    DateTime  @default(now())

  @@map("outreach_messages")
}

enum MessageStatus {
  DRAFT
  SENT
  FAILED
}

// ─── Agent System ─────────────────────────────────────────────────────────────

model AgentUser {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String?      // null until agent accepts invite
  inviteToken   String?      @unique
  inviteExpires DateTime?
  // Pending self-serve email change. Agent enters a new email; we send
  // a verification token to that new address and a security alert to
  // the current address. Email isn't actually swapped until the agent
  // clicks the link in the new mailbox.
  pendingEmail        String?
  pendingEmailToken   String?    @unique
  pendingEmailExpires DateTime?
  // Last successful email swap. Used for audit display and to enforce
  // a cooldown so a compromised account can't be repeatedly bounced
  // through new addresses.
  lastEmailChangeAt   DateTime?
  createdAt     DateTime     @default(now())
  lastLoginAt   DateTime?
  profile       AgentProfile?

  @@map("agent_users")
}

model AgentProfile {
  id                    String    @id @default(cuid())
  agentUserId           String    @unique
  agentUser             AgentUser @relation(fields: [agentUserId], references: [id])
  agentCode             String    @unique
  firstName             String
  lastName              String
  state                 String?
  phone                 String?
  dateOfBirth           DateTime?
  npn                   String?
  // Carriers the agent has opted in to seeing on their dashboard.
  // We never hide a carrier with an active appointment from the agent,
  // but the unselected NOT_STARTED ones are hidden so the list isn't a wall.
  selectedCarriers      String[]  @default([])
  icaDate               DateTime?
  recruiterId           String?   // agentCode of recruiter
  cft                   String?   // trainer name
  eliteCft              String?
  status                AgentStatus @default(ACTIVE)
  // Marks a profile as a QA / test account that should be hidden from
  // every roster-facing view (admin progression matrix, agent-facing
  // leaderboard, future aggregate dashboards). Test agents keep all
  // login + flow capabilities so we can exercise the agent UX as them.
  isTest                Boolean     @default(false) @map("is_test")
  phase                 Int         @default(1)
  phaseStartedAt        DateTime?   // when they entered current phase
  goal                  String?     // "MD", "EMD", etc.
  initialPointOfContact String?
  examDate              DateTime?
  ssn                   String?   // AES-256-GCM encrypted; decrypt server-side for admin only
  avatarUrl             String?   // Vercel Blob URL for profile headshot
  addressLine1          String?   // Mailing address for gifts/correspondence
  addressLine2          String?
  city                  String?
  zip                   String?
  country               String?   @default("US")
  licenseNumber         String?
  licenseLines          String?
  dateSubmittedToGfi    DateTime?
  discordJoinDate       DateTime?
  discordUserId         String?     // Discord snowflake ID for role assignment
  welcomeLetterSentAt   DateTime?
  clientProduct         String?
  licenseProcess        String?
  calendlyUrl           String?
  notes                 String?
  lastReminderSentAt    DateTime?
  lastSeenPhase         Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  phaseItems            PhaseItem[]
  carrierAppointments   CarrierAppointment[]
  milestones            RecognitionMilestone[]
  businessPartners      BusinessPartner[]
  // Inverse of BusinessPartner.linkedAgentProfile: every BP row pointing
  // at this agent because the contact-list entry was them before they
  // got onboarded. Multiple recruiters can have logged the same person,
  // so this is one-to-many.
  linkedFromBusinessPartners BusinessPartner[] @relation("BusinessPartnerLinkedAgent")
  policies              PolicyEntry[]    @relation("PolicyWriter")
  splitPolicies         PolicyEntry[]    @relation("PolicySplit")
  policyComments        PolicyComment[]
  policyActivity        PolicyActivity[] @relation("PolicyActivityActor")
  policyViews           PolicyView[]
  notifications         Notification[]
  submissionMutes       NewBusinessSubmissionMute[]
  submissionActivity    NewBusinessSubmissionActivity[] @relation("SubmissionActivityActor")
  callLogs              CallLog[]
  callReviews           CallReview[]
  coordinatorRequests   CoordinatorRequest[]
  licensingNotes        LicensingNote[]
  referrals             AgentReferral[]
  pfr                   PersonalFinancialReview?
  feedback              AgentFeedback[]
  authoredFeedbackNotes AgentFeedbackNote[]
  // Phase items where THIS agent was claimed as someone's recruit.
  // Inverse of PhaseItem.linkedAgentProfile.
  claimedAsRecruitItems PhaseItem[]              @relation("PhaseItemRecruitLink")
  announcementReads     AnnouncementRead[]
  submissions           NewBusinessSubmission[] @relation("SubmissionAgent")
  splitSubmissions      NewBusinessSubmission[] @relation("SplitPartner")
  authoredSubmissionNotes NewBusinessNote[]     @relation("SubmissionNoteAgent")
  ftas                  FieldTrainingAppointment[]
  trainingAttendances   TrainingAttendance[]
  resolvedOrphans       TrainingAttendanceOrphan[] @relation("OrphanResolved")
  zoomAliases           AgentZoomAlias[]

  @@index([recruiterId])
  @@map("agent_profiles")
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

model PersonalFinancialReview {
  id              String       @id @default(cuid())
  agentProfileId  String       @unique
  agentProfile    AgentProfile @relation(fields: [agentProfileId], references: [id])
  monthlyIncome   Float        @default(0)
  expenses        Json         @default("{}")
  assets          Json         @default("{}")
  debts           Json         @default("{}")
  buckets         Json         @default("{}")
  retirementAge   Int?
  spouseRetAge    Int?
  desiredMonthlyRetirement Float @default(0)
  monthlySavingsCommitment Float @default(0)
  whatWouldThisDo String?
  whatIsStopping  String?
  dreamsAndGoals  Json         @default("[]")
  notes           String?
  updatedAt       DateTime     @updatedAt
  createdAt       DateTime     @default(now())

  @@map("personal_financial_reviews")
}

model PhaseItemDefinition {
  id          String  @id @default(cuid())
  phase       Int
  itemKey     String  @unique
  label       String
  description String
  duration    String?
  groupKey    String?
  sortOrder   Int     @default(0)
  adminOnly   Boolean @default(false)
  actionJson  String?
  coordinatorTopic String?
  linkedProgression String?
  // Optional walkthrough video. Accepts a Loom share URL (preferred — embeds
  // via iframe) or any direct video URL (Vercel Blob upload, mp4, etc.).
  // The agent-side checklist renderer detects which to use.
  videoUrl    String?
  videoTitle  String?
  // Ordered list of walkthrough videos: [{ url: string, title: string|null }, ...].
  // Replaces the singular videoUrl/videoTitle columns above (those stay populated
  // with videos[0] for back-compat until they're dropped in a follow-up migration).
  videos      Json     @default("[]")
  // Discord notification toggles, configured per-item in the checklist
  // editor. postToActivity is on by default so the #agent-activity feed
  // captures every completion; the other two are opt-in for items that
  // should also @ping Vick (so he can personally congratulate the agent)
  // or broadcast to #announcements (so the whole team sees the milestone).
  postToActivity        Boolean  @default(true)  @map("post_to_activity")
  pingAdmin             Boolean  @default(false) @map("ping_admin")
  postToAnnouncements   Boolean  @default(false) @map("post_to_announcements")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("phase_item_definitions")
}

model PhaseGroupDefinition {
  id          String  @id @default(cuid())
  phase       Int
  groupKey    String  @unique
  label       String
  icon        String?
  description String?
  showTrainer Boolean @default(false)
  sortOrder   Int     @default(0)
  // Optional banner videos shown at the top of this step on the agent
  // dashboard. Same JSON shape as PhaseItemDefinition.videos:
  // [{ url: string, title: string|null }, ...]. Used for Melinee's
  // "Welcome to Step N" intro videos and any future per-step content.
  videos      Json    @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("phase_group_definitions")
}

model ProgressionDefinition {
  id          String  @id @default(cuid())
  key         String  @unique
  label       String
  description String
  icon        String?
  achievedWhen String
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("progression_definitions")
}

model EmailTemplate {
  id          String  @id @default(cuid())
  key         String  @unique
  label       String
  subject     String
  bodyHtml    String
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("email_templates")
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  message     String
  targetPhase Int?
  active      Boolean  @default(true)
  // When the announcement should start being visible to agents.
  // Null means "live as soon as it's created" (legacy behavior).
  // Set to a future date to schedule it ahead of time; the agent
  // GET endpoint filters out announcements where scheduledFor > now.
  scheduledFor DateTime?
  createdBy   String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  reads       AnnouncementRead[]

  @@map("announcements")
}

model AnnouncementRead {
  id              String       @id @default(cuid())
  announcementId  String
  announcement    Announcement @relation(fields: [announcementId], references: [id])
  agentProfileId  String
  agentProfile    AgentProfile @relation(fields: [agentProfileId], references: [id])
  readAt          DateTime     @default(now())

  @@unique([announcementId, agentProfileId])
  @@map("announcement_reads")
}

model AgentFeedback {
  id              String       @id @default(cuid())
  agentProfileId  String
  agentProfile    AgentProfile @relation(fields: [agentProfileId], references: [id])
  category        String       @default("general")
  message         String
  // Legacy read-flag, kept around so existing list filters keep working.
  // Auto-set to true the moment status moves off OPEN.
  read            Boolean      @default(false)
  // Workflow status. String (not enum) so future statuses don't need a
  // migration. Allowed values: OPEN | ACKNOWLEDGED | IN_PROGRESS | CLOSED.
  status          String       @default("OPEN")
  reviewedAt      DateTime?    // first time status moved off OPEN
  closedAt        DateTime?
  // Vercel Blob URLs for screenshots the agent attached when submitting
  // (or later edited in). Capped to 4 per ticket at the API layer; bare
  // string array since we never need to query individual rows. Frontend
  // renders as click-to-enlarge thumbnails on the agent + admin views.
  screenshotUrls  String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt @default(now())

  notes           AgentFeedbackNote[]

  @@map("agent_feedback")
}

// Threaded back-and-forth on a single AgentFeedback item. Replaces
// the original "single responseToAgent + single adminNotes" pattern
// with a real ticket conversation: admins post visible replies or
// internal-only notes, agents post clarification questions, both
// sides see chronological history. The legacy responseToAgent +
// adminNotes columns on AgentFeedback stay populated for a transition
// window and are seeded into this table by the migration.
model AgentFeedbackNote {
  id                   String         @id @default(cuid())
  feedbackId           String
  feedback             AgentFeedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  body                 String
  // true = admin/LC-only context, hidden from the agent.
  // Agent-authored notes are always isInternal=false.
  isInternal           Boolean        @default(false)
  // Exactly one author column is set per row. authorAdminId for admin/LC
  // posts, authorAgentProfileId for agent replies. SetNull on delete so
  // a deleted user doesn't take their old notes with them.
  authorAdminId        String?
  authorAdmin          AdminUser?     @relation(fields: [authorAdminId], references: [id], onDelete: SetNull)
  authorAgentProfileId String?
  authorAgentProfile   AgentProfile?  @relation(fields: [authorAgentProfileId], references: [id], onDelete: SetNull)
  createdAt            DateTime       @default(now())

  @@index([feedbackId, createdAt])
  @@map("agent_feedback_notes")
}

enum ReferralStatus {
  PENDING
  APPROVED
  REJECTED
}

model AgentReferral {
  id              String         @id @default(cuid())
  referringAgentId String
  referringAgent  AgentProfile   @relation(fields: [referringAgentId], references: [id])
  firstName       String
  lastName        String
  email           String
  phone           String?
  state           String?
  notes           String?
  status          ReferralStatus @default(PENDING)
  adminNotes      String?
  approvedById    String?
  approvedAt      DateTime?
  createdAgentId  String?
  createdAt       DateTime       @default(now())

  @@map("agent_referrals")
}

model PhaseItem {
  id             String       @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id])
  phase          Int
  itemKey        String
  completed      Boolean      @default(false)
  completedAt    DateTime?
  // Discord message IDs for the activity-channel post and the
  // announcements broadcast emitted when this item was completed.
  // Stored so we can DELETE those messages if the agent un-checks the
  // item, instead of leaving the celebratory post dangling. Null when
  // the item's definition had notifications disabled, or when the
  // completion happened before this column existed.
  activityMsgId       String?
  announcementMsgId   String?
  // Optional link to a specific recruited agent. Only meaningful for
  // the direct_1/2/3 "Recruit & Onboard Your Nth Agent" phase items —
  // when the recruiter claims an existing AFF agent as their recruit,
  // we record which agent fulfilled this checklist slot so the
  // milestone has provenance and admins can audit who claimed whom.
  // SetNull on delete so removing the recruited agent doesn't take
  // the milestone with them.
  linkedAgentProfileId String?
  linkedAgentProfile   AgentProfile? @relation("PhaseItemRecruitLink", fields: [linkedAgentProfileId], references: [id], onDelete: SetNull)
  updatedAt      DateTime     @updatedAt

  @@unique([agentProfileId, phase, itemKey])
  @@index([linkedAgentProfileId])
  @@map("phase_items")
}

model CarrierAppointment {
  id             String            @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile      @relation(fields: [agentProfileId], references: [id])
  carrier        String
  carrierType    String?
  status         AppointmentStatus @default(NOT_STARTED)
  producerNumber String?
  writingCode    String?
  sureLcDate     DateTime?
  googleFormDate DateTime?
  readyToSubmit  Boolean           @default(false)
  appointedDate  DateTime?
  notes          String?
  updatedAt      DateTime          @updatedAt

  @@unique([agentProfileId, carrier])
  @@map("carrier_appointments")
}

enum AppointmentStatus {
  NOT_STARTED
  PENDING
  APPOINTED
  JIT
}

model RecognitionMilestone {
  id             String       @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id])
  milestone      String
  // PENDING_REVIEW: agent submitted, awaiting admin
  // AWARDED:        admin approved (or auto-awarded via backfill)
  // REJECTED:       admin rejected; agent can resubmit (the row is re-used)
  status         MilestoneStatus @default(AWARDED)
  // requestedAt is null for admin-initiated awards (no submission flow).
  requestedAt    DateTime?
  // Optional proof / context the agent provided when submitting.
  requestNote    String?
  // When the admin acted. completedAt is the ceremonial "you've earned this"
  // timestamp; reviewedAt is the audit timestamp for who clicked the button.
  reviewedAt     DateTime?
  reviewerAdminId String?
  reviewer       AdminUser?   @relation("MilestoneReviewer", fields: [reviewerAdminId], references: [id])
  reviewNote     String?
  completedAt    DateTime     @default(now())
  notes          String?

  @@unique([agentProfileId, milestone])
  @@index([status])
  @@map("recognition_milestones")
}

enum MilestoneStatus {
  PENDING_REVIEW
  AWARDED
  REJECTED
}

model BusinessPartner {
  id              String       @id @default(cuid())
  agentProfileId  String
  agentProfile    AgentProfile @relation(fields: [agentProfileId], references: [id])
  name            String
  email           String?
  phone           String?
  timeZone        String?
  age             String?
  married         Boolean      @default(false)
  children        Boolean      @default(false)
  occupation      String?
  characterTraits String?
  appointmentDate DateTime?
  icaDate         DateTime?
  firstCallDate   DateTime?
  secondCallDate  DateTime?
  homeowner       Boolean      @default(false)
  category        String?
  notes           String?
  phaseItemKey    String?
  bookedAppt      Boolean      @default(false)
  // CEO intro email: when the agent has Vick send a "thought you'd be a
  // great fit" intro. Tracked so the row can show "Intro sent <date>" and
  // the button can disable itself; nullable because most rows never get
  // an intro.
  introSentAt     DateTime?
  introMessageId  String?      // GHL message id for the audit trail
  source          String?      // 'manual' | 'csv_import' (for analytics)
  // Workflow lifecycle. Imports land as PENDING (the queue). Classifying
  // them as Business Partner / FTA / Recruit stamps category + advances
  // them to NEW. Each lane then progresses through its own stages.
  // SKIPPED = "I went through this contact and decided not to pursue,"
  // hidden from queue but kept so re-imports don't re-queue them.
  status          String       @default("PENDING")  // PENDING | NEW | CONTACTED | INTRO_SENT | BOOKED | CONVERTED | SKIPPED
  lastContactAt   DateTime?    // last meaningful action (call, email, intro)
  // When a contact-list entry's email matches an AgentUser (the recruit
  // got onboarded as an AFF agent), we eager-link the rows so the writing
  // agent can pull the new agent's NPN / license number off the BP card
  // for app submissions instead of texting them every time. Auto-set on
  // both directions (BP create and Agent create) by lib/business-partner-link.
  linkedAgentProfileId String?
  linkedAgentProfile   AgentProfile? @relation("BusinessPartnerLinkedAgent", fields: [linkedAgentProfileId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())

  // Reverse side of FieldTrainingAppointment.businessPartner relation. An
  // FTA contact (category='fta_contact') typically generates one or more
  // appointments over time, so this is a one-to-many.
  ftaAppointments FieldTrainingAppointment[]

  @@index([agentProfileId, status])
  @@index([linkedAgentProfileId])
  @@map("business_partners")
}

model SetupResource {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  url         String
  category    String   @default("general")
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("setup_resources")
}

model PolicyEntry {
  id               String       @id @default(cuid())
  agentProfileId   String
  agentProfile     AgentProfile @relation("PolicyWriter", fields: [agentProfileId], references: [id])
  policyNumber     String?
  clientName       String
  carrier          String
  product          String
  // Real FK collaboration relation. The legacy splitAgentName free-text
  // column stays so historical rows + non-AFF split partners still
  // render their name; new rows prefer the relation. Authorization
  // for view + comment uses splitAgentId only.
  splitAgentId     String?
  splitAgent       AgentProfile? @relation("PolicySplit", fields: [splitAgentId], references: [id], onDelete: SetNull)
  splitAgentName   String?
  dateSubmitted    DateTime?
  targetPremium    Float?
  targetPoints     Float?
  commissionPayout Float?
  notes            String?
  // Denormalized "last comment" preview so the policies list can render
  // "VM · 2h ago: Got the underwriting back…" without an N+1 fetch per
  // row. Refreshed every time a PolicyComment is written.
  lastCommentAt       DateTime?
  lastCommentBy       String?
  lastCommentPreview  String?     @db.VarChar(200)
  createdAt        DateTime     @default(now())

  comments         PolicyComment[]
  activity         PolicyActivity[]
  views            PolicyView[]

  @@index([splitAgentId])
  @@index([lastCommentAt(sort: Desc)])
  @@map("policy_entries")
}

// Chat-style thread on a PolicyEntry. Visible to the writing agent
// (PolicyEntry.agentProfileId) AND the split agent
// (PolicyEntry.splitAgentId) regardless of phase. Both can post; only
// the author can edit / delete their own comment.
model PolicyComment {
  id              String       @id @default(cuid())
  policyEntryId   String
  policyEntry     PolicyEntry  @relation(fields: [policyEntryId], references: [id], onDelete: Cascade)
  agentProfileId  String
  agentProfile    AgentProfile @relation(fields: [agentProfileId], references: [id])
  body            String
  editedAt        DateTime?
  createdAt       DateTime     @default(now())

  @@index([policyEntryId, createdAt])
  @@map("policy_comments")
}

// Audit log on a PolicyEntry, kept separate from the conversation
// thread so admins can see "who did what when" without scrolling
// through chatter. ADDED_SPLIT, REMOVED_SPLIT, STATUS_CHANGED, OTHER.
model PolicyActivity {
  id              String       @id @default(cuid())
  policyEntryId   String
  policyEntry     PolicyEntry  @relation(fields: [policyEntryId], references: [id], onDelete: Cascade)
  actorProfileId  String?
  actor           AgentProfile? @relation("PolicyActivityActor", fields: [actorProfileId], references: [id], onDelete: SetNull)
  kind            String       // ADDED_SPLIT | REMOVED_SPLIT | STATUS_CHANGED | OTHER
  metaJson        Json?
  createdAt       DateTime     @default(now())

  @@index([policyEntryId])
  @@map("policy_activity")
}

// Unified in-app notification. Every agent-targeted alert (feedback
// responses, policy comments, training reminders, announcements,
// promotions) writes one row here. The SSE stream watches this table
// and pushes new rows to the recipient's open client(s); the
// createNotification() helper in src/lib/notify.ts fans out a
// Discord DM in the same call when the recipient has discordUserId.
model Notification {
  id                       String   @id @default(cuid())
  recipientAgentProfileId  String
  recipientAgentProfile    AgentProfile @relation(fields: [recipientAgentProfileId], references: [id], onDelete: Cascade)
  // Dotted event identifier (e.g. 'feedback.response'). Drives the
  // client-side dispatcher and the future per-event mute UI.
  kind                     String
  // What this is about, so deep links resolve. e.g. subjectType='feedback'.
  subjectType              String
  subjectId                String?
  title                    String
  body                     String?
  linkUrl                  String?
  color                    Int?
  readAt                   DateTime?
  createdAt                DateTime @default(now())

  @@index([recipientAgentProfileId, createdAt(sort: Desc)])
  @@index([recipientAgentProfileId, readAt])
  @@map("notifications")
}

// Per-agent, per-policy lastViewedAt for the unread-dot indicator on
// the policies list. Also carries a per-policy `muted` flag so an
// agent can silence Discord pings for a specific noisy thread without
// affecting their other policies.
model PolicyView {
  id              String       @id @default(cuid())
  policyEntryId   String
  policyEntry     PolicyEntry  @relation(fields: [policyEntryId], references: [id], onDelete: Cascade)
  agentProfileId  String
  agentProfile    AgentProfile @relation(fields: [agentProfileId], references: [id])
  lastViewedAt    DateTime     @default(now())
  muted           Boolean      @default(false)

  @@unique([policyEntryId, agentProfileId])
  @@map("policy_views")
}

model CallLog {
  id               String                @id @default(cuid())
  agentProfileId   String
  agentProfile     AgentProfile          @relation(fields: [agentProfileId], references: [id])
  callDate         DateTime
  contactName      String
  phoneNumber      String?
  subject          String?
  notes            String?
  result           String?
  followUpNeeded   Boolean               @default(false)
  createdAt        DateTime              @default(now())

  transcriptText   String?
  transcriptSource CallTranscriptSource?
  durationSeconds  Int?
  review           CallReview?

  @@map("call_logs")
}

enum CallTranscriptSource {
  MANUAL_PASTE
  FATHOM_OAUTH
  FATHOM_MANUAL
}

model CallReview {
  id                 String       @id @default(cuid())
  callLogId          String       @unique
  callLog            CallLog      @relation(fields: [callLogId], references: [id], onDelete: Cascade)
  agentProfileId     String
  agentProfile       AgentProfile @relation(fields: [agentProfileId], references: [id])

  overallScore       Int
  rubricScores       Json
  strengths          Json
  weaknesses         Json
  coachingTips       Json
  nextSteps          Json
  summary            String

  flaggedForCoaching Boolean      @default(false)
  adminNotes         String?
  discussedAt        DateTime?

  modelId            String
  inputTokens        Int
  outputTokens       Int
  cacheReadTokens    Int          @default(0)
  cacheCreateTokens  Int          @default(0)
  reviewedAt         DateTime     @default(now())

  @@index([agentProfileId, reviewedAt])
  @@map("call_reviews")
}

enum LicensingRequestTopic {
  SCHEDULE_EXAM
  PASS_POST_LICENSING
  FINGERPRINTS_APPLY
  GFI_APPOINTMENTS
  CE_COURSES
  EO_INSURANCE
  DIRECT_DEPOSIT
  UNDERWRITING
  GENERAL
}

enum LicensingRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model CoordinatorRequest {
  id             String                 @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile           @relation(fields: [agentProfileId], references: [id])
  phaseItemKey   String?
  topic          LicensingRequestTopic
  message        String
  status         LicensingRequestStatus @default(OPEN)
  assignedToId   String?
  assignedTo     AdminUser?             @relation("AssignedCoordinator", fields: [assignedToId], references: [id])
  resolutionNote String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  resolvedAt     DateTime?
  // Threaded back-and-forth between the agent and the LC. The original
  // request body lives in `message` (one-shot from the agent at submit
  // time); subsequent replies in either direction land here so the LC
  // can send an interim "here's the link, schedule when you can" reply
  // without having to mark the request resolved.
  messages       CoordinatorMessage[]

  @@index([agentProfileId, status])
  @@index([status, assignedToId])
  @@map("coordinator_requests")
}

// One message in a coordinator-request thread. Separate from the parent
// request's `message` field (which is the original ask) so we have a
// clean append-only log of replies on both sides.
model CoordinatorMessage {
  id           String              @id @default(cuid())
  requestId    String
  request      CoordinatorRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // 'agent' | 'admin' | 'licensing_coordinator' - matches the role names
  // we use on the session.user.role. Stored as a string instead of an
  // enum so adding new sender types later doesn't require a migration.
  fromRole     String
  // FK to whichever user table the sender lives in. We don't add a
  // relation here because the sender could be either AgentProfile or
  // AdminUser; the role+id pair is enough to render attribution.
  fromUserId   String
  // Display name at send time so the thread renders without a join
  // even if the user's name later changes (or they're deactivated).
  fromName     String
  body         String
  createdAt    DateTime            @default(now())

  @@index([requestId, createdAt])
  @@map("coordinator_messages")
}

enum NoteScope {
  LICENSING   // visible to licensing coordinators AND admins
  ADMIN_ONLY  // visible to admins only — LC cannot see these
}

enum TrainingStreamType {
  GFI_LIVE
  ZOOM
}

model TrainingEvent {
  id                    String             @id @default(cuid())
  driveFileId           String?            // null for manually created events
  eventIndex            Int                @default(0)
  driveFileName         String?            // nullable (manual events have no Drive file)
  driveModifiedTime     DateTime?          // nullable
  driveThumbnailUrl     String?

  // Vercel Blob URL — reliable public CDN for Discord embeds.
  // Populated during sync (mirror from Drive) or on manual upload.
  flyerImageUrl         String?

  // Publish toggle — controls Discord scheduled event + T-15 reminders.
  // Default true so auto-synced events publish immediately.
  // Set false to suppress without deleting the row.
  published             Boolean            @default(true)

  title                 String
  subtitle              String?
  category              String?
  startsAt              DateTime           // canonical UTC
  durationMinutes       Int                @default(60)
  presenters            Json               // [{ name, role }]

  streamType            TrainingStreamType @default(GFI_LIVE)
  streamRoomName        String?
  streamId              String?
  passcode              String?

  audienceRestriction   String?
  partnerBrand          String?
  targetRegion          String?

  // Discord plumbing
  discordEventId        String?
  discordEventCreatedAt DateTime?
  reminderSentAt        DateTime?

  // Parse metadata (Drive-synced events only)
  parsedAt              DateTime           @default(now())
  parseError            String?
  rawParseJson          Json?
  modelId               String?
  inputTokens           Int                @default(0)
  outputTokens          Int                @default(0)

  // Manual override flag — admin edited the parsed values, don't re-overwrite
  manuallyEdited        Boolean            @default(false)

  // Recurrence — populated when the admin creates a recurring training. Each
  // occurrence is its own TrainingEvent row, linked back to the parent so we
  // can find siblings and roll forward more occurrences when the series is
  // running low. Self-relation: parent's recurrenceParentId is null and it
  // owns a children[] of upcoming + past instances.
  recurrenceParentId    String?
  recurrenceParent      TrainingEvent?     @relation("TrainingRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceChildren    TrainingEvent[]    @relation("TrainingRecurrence")
  recurrenceFrequency   String?            // 'WEEKLY' for now; future: DAILY / BIWEEKLY / MONTHLY

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // PostgreSQL allows multiple NULLs in unique constraints, so manual events
  // (driveFileId=null) won't conflict with each other.
  @@unique([driveFileId, eventIndex])
  @@index([startsAt])
  @@index([reminderSentAt])
  @@index([published, startsAt])
  @@index([recurrenceParentId])
  // Tracks the most recent Zoom attendance pull so the cron can skip
  // events it already synced. Null until the first sync runs.
  attendanceSyncedAt    DateTime?
  // Whether this event participates in the attendance grid + cron.
  // Default true so newly-parsed flyers are tracked by default;
  // admins flip this off for events they don't want surfaced (e.g.
  // Onboarding Academy, hierarchy calls, guest broadcasts that don't
  // happen on the AFF Zoom account).
  trackAttendance       Boolean   @default(true)
  attendances           TrainingAttendance[]
  attendanceOrphans     TrainingAttendanceOrphan[]
  @@map("training_events")
}

// Per-(training, agent) attendance row. We keep one row per active
// agent per ZOOM-streamed training so the grid view can render dense
// without extra joins. Computed status is filled by the Zoom sync;
// admins can override via manualStatus to Excuse / Not Tracking.
model TrainingAttendance {
  id                String                   @id @default(cuid())
  trainingEventId   String
  trainingEvent     TrainingEvent            @relation(fields: [trainingEventId], references: [id], onDelete: Cascade)
  agentProfileId    String
  agentProfile      AgentProfile             @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)

  // Effective status surfaced in the grid. Equals manualStatus when the
  // admin has overridden, otherwise mirrors the Zoom-derived value.
  status            TrainingAttendanceStatus
  // Admin override; null means "use the auto-computed status."
  manualStatus      TrainingAttendanceStatus?
  manualNote        String?

  // Raw Zoom data — useful for audit when Vick wants to see why
  // someone got marked Absent or Present.
  zoomDisplayName   String?
  zoomEmail         String?
  zoomUserId        String?
  joinedAt          DateTime?
  leftAt            DateTime?
  durationSeconds   Int?

  source            String                   @default("zoom")  // 'zoom' | 'manual' | 'backfill'
  syncedAt          DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([trainingEventId, agentProfileId])
  @@index([trainingEventId, status])
  @@index([agentProfileId, status])
  @@map("training_attendances")
}

// Zoom participants we couldn't match to an AgentProfile by email or
// fuzzy name. Admin resolves them in a queue; resolution writes a real
// TrainingAttendance row and deletes the orphan. Kept in its own table
// so the dense grid query stays fast.
model TrainingAttendanceOrphan {
  id                String        @id @default(cuid())
  trainingEventId   String
  trainingEvent     TrainingEvent @relation(fields: [trainingEventId], references: [id], onDelete: Cascade)

  zoomDisplayName   String
  zoomEmail         String?
  zoomUserId        String?
  joinedAt          DateTime
  durationSeconds   Int

  // When the admin maps this orphan to an agent we keep the link in
  // case we want to remember the Zoom alias for next time. Once
  // resolved we also write the corresponding TrainingAttendance row.
  resolvedAgentId   String?
  resolvedAgent     AgentProfile? @relation("OrphanResolved", fields: [resolvedAgentId], references: [id], onDelete: SetNull)
  resolvedAt        DateTime?

  createdAt         DateTime      @default(now())

  @@index([trainingEventId])
  @@index([resolvedAt])
  @@map("training_attendance_orphans")
}

enum TrainingAttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  NOT_TRACKING
  NOT_JOINED_YET
}

// Alternate Zoom display names / emails an agent has been seen joining
// Zoom under. Each row is one alias; an agent can have many. The
// matcher checks aliases first so that resolving an orphan once
// teaches the system permanently. Append-only: when the agent updates
// their Zoom display name, the orphan resolver writes a new alias
// rather than replacing the old one (so historical events stay
// matched even if you change your name later).
model AgentZoomAlias {
  id              String       @id @default(cuid())
  agentProfileId  String
  agentProfile    AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)

  // Pre-normalized display-name key used by the matcher, OR a raw
  // lowercased email. Only one of these is set per row; the matcher
  // checks both.
  nameKey         String?
  email           String?

  // What we saw on Zoom (kept verbatim for the admin UI listing
  // aliases on an agent's profile in the future).
  rawDisplayName  String?

  // Where the alias came from -- helps audit if a wrong resolution
  // ever needs unwinding.
  source          String       @default("orphan_resolve")
  createdAt       DateTime     @default(now())

  // Both nameKey and email are unique across the whole table so a
  // single Zoom name/email can't claim two different agents at once.
  // Postgres treats nulls as distinct so unrelated aliases on the
  // other field don't collide.
  @@unique([nameKey])
  @@unique([email])
  @@index([agentProfileId])
  @@map("agent_zoom_aliases")
}

model LicensingNote {
  id             String       @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  authorId       String
  author         AdminUser    @relation(fields: [authorId], references: [id])
  body           String
  scope          NoteScope    @default(LICENSING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([agentProfileId, scope, createdAt])
  @@map("licensing_notes")
}

// ─── New Business / FTA / Clients ─────────────────────────────────────────────

enum NewBusinessStatus {
  PENDING
  ISSUED
  DECLINED
  LAPSED
  NOT_TAKEN
}

enum PolicyType {
  TERM
  WHOLE_LIFE
  IUL
  ANNUITY
  DISABILITY
  LTC
  OTHER
}

enum NoteAuthorType {
  AGENT
  ADMIN
}

enum FtaCategory {
  UNDER_50
  FIFTY_PLUS
  FIFTY_NINE_HALF_PLUS
  JUST_RETIRED
  TRANSITIONING_JOBS
  RECEIVED_INHERITANCE
}

model NewBusinessSubmission {
  id                  String        @id @default(cuid())
  agentProfileId      String
  agentProfile        AgentProfile  @relation("SubmissionAgent", fields: [agentProfileId], references: [id], onDelete: Cascade)

  applicationDate     DateTime
  carrier             String
  policyType          PolicyType
  points              Float?
  splitWithAgentId    String?
  splitWithAgent      AgentProfile? @relation("SplitPartner", fields: [splitWithAgentId], references: [id])
  illustrationUrls    String[]

  clientFirstName     String
  clientLastName      String
  clientPhone         String?
  clientEmail         String?
  clientBirthday      DateTime?
  clientAddressLine1  String?
  clientAddressLine2  String?
  clientCity          String?
  clientState         String?
  clientZip           String?

  status              NewBusinessStatus @default(PENDING)
  issuedDate          DateTime?
  policyNumber        String?
  declinedReason      String?
  assignedToId        String?
  assignedTo          AdminUser?    @relation("AssignedSubmissions", fields: [assignedToId], references: [id])

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  notes               NewBusinessNote[]
  renewalReminders    RenewalReminder[]
  mutes               NewBusinessSubmissionMute[]
  activity            NewBusinessSubmissionActivity[]

  @@index([agentProfileId, status])
  @@index([status, createdAt])
  @@index([clientLastName, clientFirstName])
  @@map("new_business_submissions")
}

// Audit-log row attached to a NewBusinessSubmission. Captures key
// lifecycle events (created, split agent added/removed, status
// changed) so the Activity tab in the drawer can render a readable
// "who did what when" timeline distinct from the notes thread.
model NewBusinessSubmissionActivity {
  id                  String  @id @default(cuid())
  submissionId        String
  submission          NewBusinessSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actorAgentProfileId String?
  actorAgent          AgentProfile? @relation("SubmissionActivityActor", fields: [actorAgentProfileId], references: [id], onDelete: SetNull)
  actorAdminId        String?
  actorAdmin          AdminUser?    @relation("SubmissionActivityAdmin", fields: [actorAdminId], references: [id], onDelete: SetNull)
  // CREATED | SPLIT_ADDED | SPLIT_REMOVED | STATUS_CHANGED | OTHER.
  // Plain string so adding a new kind doesn't need a migration.
  kind                String
  metaJson            Json?
  createdAt           DateTime @default(now())

  @@index([submissionId, createdAt])
  @@map("new_business_submission_activity")
}

// Per-agent, per-submission mute. When a row exists, suppress the
// out-of-band Discord DM for new comments on that submission;
// in-app row + bell-icon ping still fire so the agent can catch up
// when they're in-portal. Either the writer or the split agent can
// create their own row.
model NewBusinessSubmissionMute {
  id              String   @id @default(cuid())
  submissionId    String
  submission      NewBusinessSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  agentProfileId  String
  agentProfile    AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([submissionId, agentProfileId])
  @@map("new_business_submission_mutes")
}

enum RenewalStage {
  SIXTY_DAYS
  THIRTY_DAYS
  SEVEN_DAYS
}

model RenewalReminder {
  id              String                @id @default(cuid())
  submissionId    String
  submission      NewBusinessSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  stage           RenewalStage
  anniversaryYear Int
  sentAt          DateTime              @default(now())
  sentByAdminId   String?
  sentBy          AdminUser?            @relation("RenewalRemindersSent", fields: [sentByAdminId], references: [id])

  @@unique([submissionId, stage, anniversaryYear])
  @@index([submissionId])
  @@map("renewal_reminders")
}

model NewBusinessNote {
  id              String                @id @default(cuid())
  submissionId    String
  submission      NewBusinessSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  body            String
  authorType      NoteAuthorType
  authorAgentId   String?
  authorAgent     AgentProfile?         @relation("SubmissionNoteAgent", fields: [authorAgentId], references: [id])
  authorAdminId   String?
  authorAdmin     AdminUser?            @relation("SubmissionNoteAdmin", fields: [authorAdminId], references: [id])

  createdAt       DateTime              @default(now())

  @@index([submissionId, createdAt])
  @@map("new_business_notes")
}

model FieldTrainingAppointment {
  id                String       @id @default(cuid())
  agentProfileId    String
  agentProfile      AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)

  // Optional link to the BusinessPartner this appointment is with. Going
  // forward the agent picks an FTA contact from their imported book; the
  // name/phone columns below stay populated as a snapshot so legacy rows
  // (created before this field existed) don't break, and so the
  // appointment list still reads even if the contact is later deleted.
  businessPartnerId String?
  businessPartner   BusinessPartner? @relation(fields: [businessPartnerId], references: [id], onDelete: SetNull)

  name              String
  phone             String?
  timeZone          String?
  age               Int?
  married           Boolean?
  children          Int?
  homeowner         Boolean?
  occupation60kPlus Boolean?
  appointmentDate   DateTime
  notes             String?
  category          FtaCategory?

  // Lifecycle of the appointment. Only COMPLETED appointments count
  // toward the agent's "Field Training N" Phase 2 checklist items;
  // RESCHEDULED bumps appointmentDate forward but stays in-flight;
  // CANCELLED and NO_SHOW are terminal failures and don't count.
  status            FtaStatus    @default(SCHEDULED)
  outcomeNotes      String?
  // First date this appointment was originally booked for, preserved
  // through reschedules so the agent can see how many times it's been
  // pushed.
  originalDate      DateTime?
  // Stamps for the lifecycle transitions
  completedAt       DateTime?
  cancelledAt       DateTime?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([agentProfileId, appointmentDate])
  @@index([agentProfileId, status])
  @@map("field_training_appointments")
}

enum FtaStatus {
  SCHEDULED
  COMPLETED
  RESCHEDULED
  CANCELLED
  NO_SHOW
}
