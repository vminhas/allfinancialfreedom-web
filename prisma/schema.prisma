// ─── Email template system ────────────────────────────────────────────
//
// DB-driven replacement for the hardcoded HTML emails the GHL webhook
// used to fire. Each EmailSender is a verified "from" identity; each
// EmailTemplate ties a GHL event type to a sender + subject + body
// (WYSIWYG, stored as HTML), and the webhook iterates every enabled
// template matching the inbound event. See
// src/app/api/ghl-webhook/route.ts and src/lib/email-template.ts.

model EmailSender {
  id        String          @id @default(cuid())
  // Stable identifier for code-driven seeds + admin lookups.
  // "vick", "operations", "contact", "melinee".
  key       String          @unique
  name      String          // Display name in the email From header.
  email     String          // Verified mailbox.
  role      String?         // "CEO", "Operations", "COO" — display only.
  isDefault Boolean         @default(false) @map("is_default")
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt      @map("updated_at")
  templates EmailTemplate[]

  @@map("email_senders")
}

// Log of every inbound GHL webhook hit. Powers the "connection
// verification" surface in /vault/email-templates so an admin can
// confirm GHL is actually pinging us and see which templates fired
// per event. Also useful as an audit trail when a workflow runs but
// no email lands in the recipient's inbox.
model GhlWebhookEvent {
  id               String   @id @default(cuid())
  eventType        String   @map("event_type")
  contactId        String?  @map("contact_id")
  contactEmail     String?  @map("contact_email")
  payload          Json
  receivedAt       DateTime @default(now()) @map("received_at")
  templatesFired   String[] @default([])    @map("templates_fired")
  templatesSkipped String[] @default([])    @map("templates_skipped")
  error            String?

  @@index([eventType, receivedAt(sort: Desc)])
  @@index([receivedAt(sort: Desc)])
  @@map("ghl_webhook_events")
}

// The editable daily-motivation library. Seeded once from the static
// MOTIVATION_SEED in src/lib/motivation-quotes.ts (see ensureMotivationSeeded);
// after that the vault editor at /vault/motivation is the source of truth.
// The cron picks deterministically by date over the *active* rows ordered
// by (sortKey, createdAt, id) so the same date always yields the same line
// and edits to inactive rows never shift the rotation mid-stream.
model MotivationQuote {
  id        String   @id @default(cuid())
  text      String
  // Tonal register, not an attribution: classic | decisive | maxout |
  // state | warmth | courage | grit. Free-form so the editor can add more.
  voice     String   @default("classic")
  // Optional "in the spirit of <name>" credit shown under the line.
  attribution String? @map("attribution")
  active    Boolean  @default(true)
  sortKey   Int      @default(0) @map("sort_key")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([active, sortKey, createdAt])
  @@map("motivation_quotes")
}

// ─────────────────────────────────────────────────────────────────
// Public team page (/team) members. One table covers all three
// sections so the admin can manage everything from one editor; the
// `section` enum tells the public page which layout to render in.
//   - LEADERSHIP: Vick / Melinee (large cards w/ bio + credentials)
//   - DIRECTOR:   Jeremy etc. (side-by-side photo + bio + calendly)
//   - ASSOCIATE:  the Senior Associates grid (specialty + location)
// Fields that don't apply to a section stay null. sortOrder is a
// per-section integer the admin reorders via drag.
// ─────────────────────────────────────────────────────────────────
enum TeamSection {
  LEADERSHIP
  DIRECTOR
  ASSOCIATE
}

model TeamMember {
  id          String      @id @default(cuid())
  section     TeamSection
  sortOrder   Int         @default(0) @map("sort_order")
  name        String
  title       String?
  credentials String?
  specialty   String?
  location    String?
  initials    String?
  imageUrl    String?     @map("image_url")
  bio         String?
  calendly    String?
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt      @map("updated_at")

  @@index([section, sortOrder])
  @@map("team_members")
}

// Permanent "don't surface this Zoom guest again" list for attendance
// matching. Without this, dismissing an unmatched attendee only hid it
// until the next sync recreated the orphan row. The attendance sync
// checks this table and skips any participant whose normalized display
// name (or email) is dismissed, so a confirmed non-agent guest stays
// gone across all trainings. Un-dismissing deletes the row, letting
// them surface again. nameKey is the normalized display name; email is
// an additional match signal.
model AttendanceDismissal {
  id          String   @id @default(cuid())
  nameKey     String   @unique
  email       String?
  displayName String
  createdAt   DateTime @default(now())

  @@index([email])
  @@map("attendance_dismissals")
}

// Licensing Coordinator task list. Two kinds:
//   * recurring = true:  daily SOP steps. They show every day and are
//     considered "done today" only when completedOn == today (ET), so
//     they naturally reset each morning without a cron.
//   * recurring = false: ad-hoc one-off tasks the LC adds (birthday
//     flyers, announcement updates, Breezy messages outside the normal
//     flow, etc.). Hidden from the active list once completed on a
//     prior day; still queryable for past digests by completedOn.
// completedOn stores the ET calendar day ("YYYY-MM-DD") the task was
// last checked off, or null if not done. The nightly digest reports
// everything completed today under "Tasks".
model LcTask {
  id          String   @id @default(cuid())
  title       String
  recurring   Boolean  @default(false)
  completedOn String?  @map("completed_on")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@index([recurring, sortOrder])
  @@index([completedOn])
  @@map("lc_tasks")
}

// Auto-generated blog article drafted by the weekly cron. The
// orchestrator (src/lib/article-generator.ts) runs Opus 4.8 with web
// search, dedupes against the existing MDX corpus, writes a full MDX
// body, and stores it here as DRAFT. The blog read path includes
// PUBLISHED rows alongside the static content/blog/*.mdx files so a
// publish goes live without a redeploy.
//   status: DRAFT      created by the cron, awaiting approval
//           PUBLISHED  approved, public on /blog/<slug>
//           REJECTED   declined; kept for prompt-tuning
//   autoPublishAt: if set, the cron's follow-up publishes the draft at
//           this time unless it was already approved or rejected. Lets
//           us run "draft on Friday morning, auto-publish by noon
//           unless someone rejects."
model GeneratedArticle {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  category      String
  excerpt       String   @db.Text
  coverImage    String
  tags          String[]
  mdxBody       String   @db.Text   @map("mdx_body")
  sourceUrls    String[]            @map("source_urls")
  relatedSlugs  String[]            @map("related_slugs")
  status        String   @default("DRAFT")
  autoPublishAt DateTime?           @map("auto_publish_at")
  publishedAt   DateTime?           @map("published_at")
  rejectedReason String?            @map("rejected_reason")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  @@index([status, createdAt])
  @@index([status, autoPublishAt])
  @@map("generated_articles")
}

// One row per day the Licensing Coordinator daily digest runs.
// Gates the cron so a Vercel retry (or a double cron fire) doesn't
// email Melinee + post to Discord twice. digestDate is the ET
// calendar day ("YYYY-MM-DD"); the cron checks for an existing row
// before sending and records which channels succeeded.
model LcDigestRun {
  id         String   @id @default(cuid())
  digestDate String   @unique @map("digest_date")
  sentAt     DateTime @default(now()) @map("sent_at")
  emailOk    Boolean  @default(false) @map("email_ok")
  discordOk  Boolean  @default(false) @map("discord_ok")

  @@map("lc_digest_runs")
}

// Where a lead sits in the staff follow-up flow. NEW is the landing
// state; A-leads are called first (see scoreLead), NURTURE = low-intent
// (under $50k / "just exploring") that go to a drip, not a same-day call.
enum LeadStatus {
  NEW
  CONTACTED
  BOOKED
  NURTURE
  WON
  DEAD
}

// Scored intent tier set at capture from the savings + timing qualifiers.
//   A        = $100k+ AND income needed right away or in 1-3 yrs (call first)
//   NURTURE  = under $50k OR "just exploring" (drip, not a same-day call)
//   STANDARD = everyone else
enum LeadScore {
  A
  STANDARD
  NURTURE
}

// A lead captured from the Meta retirement-income landing page.
// This row is the TCPA system of record: it stores the exact consent
// text the person agreed to, plus when/where/how they submitted (IP,
// user agent, page URL, ad attribution). The lead is ALSO pushed to
// GoHighLevel (speed-to-lead SMS + agent routing) and Meta CAPI, but
// those are best-effort; this row is the durable, auditable copy.
model AnnuityLead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Contact
  firstName String @map("first_name")
  lastName  String @map("last_name")
  email     String
  phone     String

  // Qualifiers (stored as the human-readable option label so the consent
  // record reads exactly as the lead saw it; validated against a fixed
  // option set in the API).
  ageBand      String @map("age_band")
  savingsBand  String @map("savings_band")
  incomeTiming String @map("income_timing")
  priority     String

  score  LeadScore  @default(STANDARD)
  status LeadStatus @default(NEW)

  // TCPA consent record. consentText is the verbatim disclosure shown
  // above the submit button at the moment of consent.
  consentText String   @map("consent_text")
  consentedAt DateTime @map("consented_at")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  pageUrl     String?  @map("page_url")

  // Ad attribution (best-effort; populated from the landing URL + cookies)
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmContent  String? @map("utm_content")
  utmTerm     String? @map("utm_term")
  fbclid      String?
  referrer    String?

  // Integration bookkeeping
  ghlContactId String? @map("ghl_contact_id")
  metaEventId  String? @map("meta_event_id") // dedupe key shared with the client Pixel

  // Staff follow-up
  notes         String?
  lastContacted DateTime? @map("last_contacted")

  @@index([status, createdAt])
  @@index([score, createdAt])
  @@index([email])
  @@map("annuity_leads")
}
