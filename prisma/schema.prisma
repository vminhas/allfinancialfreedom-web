model FieldTrainingAppointment {
  id                String       @id @default(cuid())
  agentProfileId    String
  agentProfile      AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)

  // Optional link to the BusinessPartner this appointment is with. Going
  // forward the agent picks an FTA contact from their imported book; the
  // name/phone columns below stay populated as a snapshot so legacy rows
  // (created before this field existed) don't break, and so the
  // appointment list still reads even if the contact is later deleted.
  businessPartnerId String?
  businessPartner   BusinessPartner? @relation(fields: [businessPartnerId], references: [id], onDelete: SetNull)

  name              String
  phone             String?
  timeZone          String?
  age               Int?
  married           Boolean?
  children          Int?
  homeowner         Boolean?
  occupation60kPlus Boolean?
  appointmentDate   DateTime
  notes             String?
  category          FtaCategory?

  // Lifecycle of the appointment. Only COMPLETED appointments count
  // toward the agent's "Field Training N" Phase 2 checklist items;
  // RESCHEDULED bumps appointmentDate forward but stays in-flight;
  // CANCELLED and NO_SHOW are terminal failures and don't count.
  status            FtaStatus    @default(SCHEDULED)
  outcomeNotes      String?
  // First date this appointment was originally booked for, preserved
  // through reschedules so the agent can see how many times it's been
  // pushed.
  originalDate      DateTime?
  // Stamps for the lifecycle transitions
  completedAt       DateTime?
  cancelledAt       DateTime?

  phaseItems        PhaseItem[]
  slotFulfillments  AgentSlotFulfillment[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([agentProfileId, appointmentDate])
  @@index([agentProfileId, status])
  @@map("field_training_appointments")
}

