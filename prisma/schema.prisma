generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // AES-256 encrypted for sensitive keys
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AdminUser {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  role            AdminRole @default(ADMIN)
  isTest          Boolean   @default(false) @map("is_test")
  createdAt       DateTime  @default(now())
  lastLoginAt     DateTime?
  avatarUrl       String?   @map("avatar_url")
  discordUserId   String?
  discordUsername String?

  assignedRequests CoordinatorRequest[] @relation("AssignedCoordinator")
  authoredLicensingNotes LicensingNote[]
  assignedSubmissions NewBusinessSubmission[] @relation("AssignedSubmissions")
  authoredSubmissionNotes NewBusinessNote[] @relation("SubmissionNoteAdmin")
  submissionActivity NewBusinessSubmissionActivity[] @relation("SubmissionActivityAdmin")
  renewalRemindersSent RenewalReminder[] @relation("RenewalRemindersSent")
  reviewedMilestones   RecognitionMilestone[] @relation("MilestoneReviewer")
  callReviews          AdminCallReview[]
  authoredFeedbackNotes AgentFeedbackNote[]
  sentPhaseItemReminders PhaseItemReminder[] @relation("ReminderSender")
  authoredAgentNotes AgentNote[] @relation("AgentNoteAuthorAdmin")

  @@map("admin_users")
}

// Standalone coaching-tool reviews authored by an admin against a
// pasted transcript. Separate from CallReview (which is tied to an
// agent's CallLog) because admin self-reviews don't have a CallLog
// row. Lets each admin track their own progress over time on the
// same 6-dimension AFF rubric the agents are scored against.
model AdminCallReview {
  id                 String     @id @default(cuid())
  adminUserId        String
  adminUser          AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  // Free-form context the admin entered before running the analysis.
  // contactName is optional (helps Claude frame the review); callDate
  // is required so the history list has something to sort/filter on.
  contactName        String?
  callDate           DateTime
  phoneNumber        String?
  subject            String?
  callType           CallType?
  callTypeOther      String?
  followUpNeeded     Boolean    @default(false)
  // Full transcript saved so the admin can re-read it later or run a
  // re-analysis with a tweaked prompt without having to keep the
  // text around in their notes app.
  callTranscript     String     @db.Text

  overallScore       Int
  rubricScores       Json
  strengths          Json
  weaknesses         Json
  coachingTips       Json
  nextSteps          Json
  summary            String
  scoreBoosters      Json?

  // Free-form note the admin can add after the fact (e.g. "tried the
  // tip on the next call, worked great").
  notes              String?
  outcome            CallOutcome?

  modelId            String
  inputTokens        Int
  outputTokens       Int
  cacheReadTokens    Int        @default(0)
  cacheCreateTokens  Int        @default(0)
  reviewedAt         DateTime   @default(now())

  @@index([adminUserId, reviewedAt])
  @@index([reviewedAt])
  @@map("admin_call_reviews")
}

enum AdminRole {
  ADMIN
  LICENSING_COORDINATOR
}

// Audit log of sign-in attempts. Only rejected attempts are logged
// (successful sign-ins are tracked via AdminUser.lastLoginAt /
// AgentUser.lastLoginAt). Lets admins answer "did anyone try to get
// in who shouldn't have?" without trawling Vercel logs.
//
// Triggered today by the Google OAuth signIn callback when the email
// doesn't match an AdminUser or active AgentUser. Credentials-path
// failures (wrong password) are not logged here yet - those don't
// indicate someone trying to bypass approval, just a typo.
model SignInAttempt {
  id        String   @id @default(cuid())
  email     String
  provider  String   // 'google' for now
  outcome   String   // 'rejected_unknown_email' | 'rejected_inactive_agent'
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
  @@map("sign_in_attempts")
}

model ImportJob {
  id              String    @id @default(cuid())
  fileName        String
  totalRows       Int       @default(0)
  importedCount   Int       @default(0)
  skippedCount    Int       @default(0)
  errorCount      Int       @default(0)
  lastRowIndex    Int       @default(0)
  status          ImportJobStatus @default(PENDING)
  contextPrompt   String?
  wornOutStrategy String?   // "flag_column" | "manual" | "none"
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  contacts        Contact[]

  @@map("import_jobs")
}

enum ImportJobStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETE
  ERROR
}

model Contact {
  id             String    @id @default(cuid())
  ghlContactId   String?   @unique
  firstName      String
  lastName       String
  email          String    @unique
  phone          String?
  licenseType    String?   // "life" | "health" | "p&c" | "variable" | "multiple"
  currentAgency  String?
  state          String?
  source              String    @default("prophog")
  wornOut             Boolean   @default(false)
  outreachStatus      String?
  ghlOpportunityId    String?
  ghlPipelineStage    String?
  ghlStageUpdatedAt   DateTime?
  ghlAppointmentDate  DateTime?
  assignedTo          String?
  convertedAt         DateTime?
  importJobId         String?
  importJob           ImportJob? @relation(fields: [importJobId], references: [id])
  messages            OutreachMessage[]
  appointments        GhlAppointment[]
  createdAt           DateTime  @default(now())

  @@map("contacts")
}

model GhlAppointment {
  id              String    @id @default(cuid())
  ghlCalendarId   String?
  ghlEventId      String?   @unique
  calendarName    String
  contactId       String?
  contact         Contact?  @relation(fields: [contactId], references: [id])
  contactName     String
  contactEmail    String?
  contactPhone    String?
  appointmentDate DateTime
  duration        Int?
  assignedTo      String?
  status          String    @default("BOOKED")
  outcome         String?
  notes           String?
  zoomVerified    Boolean   @default(false)
  source          String?
  pipelineAction  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([contactId])
  @@index([appointmentDate])
  @@index([status])
  @@map("ghl_appointments")
}

model SuppressionEntry {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  reason    String?
  addedAt   DateTime @default(now())

  @@map("suppression_list")
}

model OutreachMessage {
  id           String    @id @default(cuid())
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id])
  subject      String
  bodyHtml     String
  status       MessageStatus @default(DRAFT)
  sentAt       DateTime?
  ghlMessageId String?
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  createdAt    DateTime  @default(now())

  @@map("outreach_messages")
}

enum MessageStatus {
  DRAFT
  SENT
  FAILED
}

// ─── Agent System ─────────────────────────────────────────────────────────────

model AgentUser {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String?      // null until agent accepts invite
  inviteToken   String?      @unique
  inviteExpires DateTime?
  // Pending self-serve email change. Agent enters a new email; we send
  // a verification token to that new address and a security alert to
  // the current address. Email isn't actually swapped until the agent
  // clicks the link in the new mailbox.
  pendingEmail        String?
  pendingEmailToken   String?    @unique
  pendingEmailExpires DateTime?
  // Last successful email swap. Used for audit display and to enforce
  // a cooldown so a compromised account can't be repeatedly bounced
  // through new addresses.
  lastEmailChangeAt   DateTime?
  createdAt     DateTime     @default(now())
  lastLoginAt   DateTime?
  profile       AgentProfile?

  @@map("agent_users")
}

model AgentProfile {
  id                    String    @id @default(cuid())
  agentUserId           String    @unique
  agentUser             AgentUser @relation(fields: [agentUserId], references: [id])
  agentCode             String    @unique
  firstName             String
  lastName              String
  // Agent-set "I go by" name. When non-null, every user-facing render
  // (Discord cards, leaderboards, team directory, welcome-email
  // greeting) substitutes this for firstName. Legal first/last on
  // file are unchanged; only admins can edit those.
  preferredName         String?   @map("preferred_name")
  state                 String?
  phone                 String?
  dateOfBirth           DateTime?
  npn                   String?
  // Carriers the agent has opted in to seeing on their dashboard.
  // We never hide a carrier with an active appointment from the agent,
  // but the unselected NOT_STARTED ones are hidden so the list isn't a wall.
  selectedCarriers      String[]  @default([])
  icaDate               DateTime?
  recruiterId           String?   // agentCode of recruiter
  cft                   String?   // trainer name
  eliteCft              String?
  status                AgentStatus @default(ACTIVE)
  // Marks a profile as a QA / test account that should be hidden from
  // every roster-facing view (admin progression matrix, agent-facing
  // leaderboard, future aggregate dashboards). Test agents keep all
  // login + flow capabilities so we can exercise the agent UX as them.
  isTest                Boolean     @default(false) @map("is_test")
  isLeadership          Boolean     @default(false) @map("is_leadership")
  isReferralPartner     Boolean     @default(false) @map("is_referral_partner")
  // Admin-set: when non-null, this agent cannot submit new referrals.
  // Used to stop a referrer who has been spamming the queue with fake
  // / placeholder emails. The block is permanent until an admin clears
  // it (sets back to null) from the referrals vault page.
  referralsBlockedAt    DateTime?   @map("referrals_blocked_at")
  referralsBlockedReason String?    @map("referrals_blocked_reason")
  // One-off "red carpet" for a single distinguished guest. When true,
  // the tracker shows an "Announce VIP Arrival" button on this profile
  // and a one-time gold welcome modal pops the first time they sign in.
  // vipArrivalTitle is the line shown under their name (e.g.
  // "Co-Founder, GFI"). Flip off to retire both.
  vipArrival            Boolean     @default(false) @map("vip_arrival")
  vipArrivalTitle       String?     @map("vip_arrival_title")
  phase                 Int         @default(1)
  phaseStartedAt        DateTime?   // when they entered current phase
  goal                  String?     // "MD", "EMD", etc.
  initialPointOfContact String?
  examDate              DateTime?
  // LC-only milestone: the agent has been added to Tevah (carrier
  // platform subscription). Distinct from the phase-checklist items
  // because it's an operational step the LC owns, not something the
  // agent does themselves. Null = not yet subscribed.
  subscribedToTevahAt   DateTime?   @map("subscribed_to_tevah_at")
  ssn                   String?   // AES-256-GCM encrypted; decrypt server-side for admin only
  avatarUrl             String?   // Vercel Blob URL for profile headshot
  addressLine1          String?   // Mailing address for gifts/correspondence
  addressLine2          String?
  city                  String?
  zip                   String?
  country               String?   @default("US")
  licenseNumber         String?
  licenseLines          String?
  dateSubmittedToGfi    DateTime?
  discordJoinDate       DateTime?
  discordUserId         String?     // Discord snowflake ID for role assignment
  welcomeLetterSentAt   DateTime?
  clientProduct         String?
  licenseProcess        String?
  calendlyUrl           String?
  notes                 String?
  lastReminderSentAt    DateTime?
  lastSeenPhase         Int?
  badges                String[]  @default([])
  clientReminderPrefs   Json?     @map("client_reminder_prefs")
  // Tevah platform IDs and synced metrics. All three are set/updated by
  // the hourly tevah-sync cron and used as the source of truth for
  // official AFF recognition (Climb milestones, leaderboard tabs).
  tevahAgentId          Int?      @map("tevah_agent_id")
  tevahPoints           Float?    @map("tevah_points")
  // Rolling monthly recruit count from Tevah byRecruit. Stored alongside
  // the month string ("2026-05") so callers can detect stale data.
  tevahMonthlyRecruits  Int?      @map("tevah_monthly_recruits")
  tevahRecruitsMonth    String?   @map("tevah_recruits_month")
  // Power-couple pairing. Two-sided: both agents have AgentProfiles and each
  // stores the other's id. One-sided: partner has no profile, use displayName.
  partnerAgentProfileId String?   @map("partner_agent_profile_id")
  partnerDisplayName    String?   @map("partner_display_name")
  coupleDisplayName     String?   @map("couple_display_name")
  coupleAvatarUrl       String?   @map("couple_avatar_url")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  phaseItems            PhaseItem[]
  carrierAppointments   CarrierAppointment[]
  milestones            RecognitionMilestone[]
  businessPartners      BusinessPartner[]
  // Inverse of BusinessPartner.linkedAgentProfile: every BP row pointing
  // at this agent because the contact-list entry was them before they
  // got onboarded. Multiple recruiters can have logged the same person,
  // so this is one-to-many.
  linkedFromBusinessPartners BusinessPartner[] @relation("BusinessPartnerLinkedAgent")
  policies              PolicyEntry[]    @relation("PolicyWriter")
  splitPolicies         PolicyEntry[]    @relation("PolicySplit")
  policyComments        PolicyComment[]
  policyActivity        PolicyActivity[] @relation("PolicyActivityActor")
  policyViews           PolicyView[]
  notifications         Notification[]
  submissionMutes       NewBusinessSubmissionMute[]
  submissionActivity    NewBusinessSubmissionActivity[] @relation("SubmissionActivityActor")
  callLogs              CallLog[]
  callReviews           CallReview[]
  coordinatorRequests   CoordinatorRequest[]
  licensingNotes        LicensingNote[]
  referrals             AgentReferral[]
  pfr                   PersonalFinancialReview?
  feedback              AgentFeedback[]
  authoredFeedbackNotes AgentFeedbackNote[]
  // Phase items where THIS agent was claimed as someone's recruit.
  // Inverse of PhaseItem.linkedAgentProfile.
  claimedAsRecruitItems PhaseItem[]              @relation("PhaseItemRecruitLink")
  announcementReads     AnnouncementRead[]
  submissions           NewBusinessSubmission[] @relation("SubmissionAgent")
  splitSubmissions      NewBusinessSubmission[] @relation("SplitPartner")
  authoredSubmissionNotes NewBusinessNote[]     @relation("SubmissionNoteAgent")
  ftas                  FieldTrainingAppointment[]
  trainingAttendances   TrainingAttendance[]
  trainingExclusion     TrainingAttendanceExclusion?
  resolvedOrphans       TrainingAttendanceOrphan[] @relation("OrphanResolved")
  zoomAliases           AgentZoomAlias[]
  phaseItemReminders    PhaseItemReminder[]        @relation("ReminderRecipient")
  climbAchievements     ClimbAchievement[]
  agentArticles         AgentArticle[]
  contestManualChecks   ContestManualCheck[]
  clientReminderFires   ClientReminderFire[]
  // Leadership notes written ABOUT this agent (subject) and notes this
  // agent wrote about people in their downline (author). Kept separate
  // so the agent never sees the "about me" side.
  agentNotesAbout       AgentNote[]                @relation("AgentNoteSubject")
  authoredAgentNotes    AgentNote[]                @relation("AgentNoteAuthorAgent")
  whyStatements         WhyStatement[]
  slotFulfillments      AgentSlotFulfillment[]

  @@index([recruiterId])
  @@map("agent_profiles")
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

// Pending-recruit record created when an ICA PDF is dropped into the
// admin activity channel (or uploaded via the web). The bot's cron
// fetches each new PDF, runs it through Claude (src/lib/parse-ica.ts)
// for structured extraction, and writes one row here per submission.
// An admin reviews the parsed fields in /vault/recruits, optionally
// edits them, then approves — which creates the live AgentProfile +
// AgentUser and fires the NEW RECRUIT announcement. Until approval
// the row is the pending state; we don't pre-create the AgentProfile
// because agentCode (unique non-null) is admin-chosen at approval time.
enum IcaSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  PARSE_FAILED
}

model IcaSubmission {
  id                    String              @id @default(cuid())
  status                IcaSubmissionStatus @default(PENDING)

  // Source tracking. Discord drops populate the message/channel/author
  // ids and the attachment URL; web uploads only have sourceType='web'
  // and pdfBlobUrl. sourceMessageId is unique so the cron can dedupe.
  sourceType            String              // 'discord' | 'web'
  sourceMessageId       String?             @unique @map("source_message_id")
  sourceChannelId       String?             @map("source_channel_id")
  sourceAuthorDiscordId String?             @map("source_author_discord_id")
  sourceAttachmentUrl   String?             @map("source_attachment_url")
  pdfBlobUrl            String?             @map("pdf_blob_url")
  pdfFilename           String?             @map("pdf_filename")

  // Parser output. parsedRaw is the JSON returned by Claude; the
  // explicit columns are the fields we surface in the review UI and
  // pre-fill on the new AgentProfile at approval time.
  rawText               String?             @map("raw_text")
  parsedRaw             Json?               @map("parsed_raw")
  parseError            String?             @map("parse_error")
  firstName             String?             @map("first_name")
  middleName            String?             @map("middle_name")
  lastName              String?             @map("last_name")
  email                 String?
  dob                   DateTime?
  gender                String?
  maritalStatus         String?             @map("marital_status")
  spouseName            String?             @map("spouse_name")
  addressLine1          String?             @map("address_line1")
  city                  String?
  state                 String?
  zip                   String?
  country               String?
  referenceCode         String?             @map("reference_code")
  classification        String?
  hasLicense            Boolean?            @map("has_license")

  // Approval bookkeeping. createdAgentProfileId is set the moment the
  // admin approves; serves as the back-reference and the indicator
  // that we already created the AgentProfile (so a re-approve doesn't
  // double-create).
  reviewedAt            DateTime?           @map("reviewed_at")
  reviewedByEmail       String?             @map("reviewed_by_email")
  reviewNote            String?             @map("review_note")
  createdAgentProfileId String?             @unique @map("created_agent_profile_id")

  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt      @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@map("ica_submissions")
}

model PersonalFinancialReview {
  id              String       @id @default(cuid())
  agentProfileId  String       @unique
  agentProfile    AgentProfile @relation(fields: [agentProfileId], references: [id])
  monthlyIncome   Float        @default(0)
  expenses        Json         @default("{}")
  assets          Json         @default("{}")
  debts           Json         @default("{}")
  buckets         Json         @default("{}")
  retirementAge   Int?
  spouseRetAge    Int?
  desiredMonthlyRetirement Float @default(0)
  monthlySavingsCommitment Float @default(0)
  whatWouldThisDo String?
  whatIsStopping  String?
  dreamsAndGoals  Json         @default("[]")
  visionBoardUrl  String?
  whyStatement    String?
  notes           String?
  updatedAt       DateTime     @updatedAt
  createdAt       DateTime     @default(now())

  @@map("personal_financial_reviews")
}

model WhyStatement {
  id              String       @id @default(cuid())
  agentProfileId  String
  agentProfile    AgentProfile @relation(fields: [agentProfileId], references: [id])
  content         String
  createdAt       DateTime     @default(now())

  @@index([agentProfileId, createdAt])
  @@map("why_statements")
}

model PhaseItemDefinition {
  id          String  @id @default(cuid())
  phase       Int
  itemKey     String  @unique
  label       String
  description String
  duration    String?
  groupKey    String?
  sortOrder   Int     @default(0)
  adminOnly   Boolean @default(false)
  actionJson  String?
  coordinatorTopic String?
  linkedProgression String?
  // Optional walkthrough video. Accepts a Loom share URL (preferred — embeds
  // via iframe) or any direct video URL (Vercel Blob upload, mp4, etc.).
  // The agent-side checklist renderer detects which to use.
  videoUrl    String?
  videoTitle  String?
  // Ordered list of walkthrough videos: [{ url: string, title: string|null }, ...].
  // Replaces the singular videoUrl/videoTitle columns above (those stay populated
  // with videos[0] for back-compat until they're dropped in a follow-up migration).
  videos      Json     @default("[]")
  // Discord notification toggles, configured per-item in the checklist
  // editor. postToActivity is on by default so the #agent-activity feed
  // captures every completion; the other two are opt-in for items that
  // should also @ping Vick (so he can personally congratulate the agent)
  // or broadcast to #announcements (so the whole team sees the milestone).
  postToActivity        Boolean  @default(true)  @map("post_to_activity")
  pingAdmin             Boolean  @default(false) @map("ping_admin")
  postToAnnouncements   Boolean  @default(false) @map("post_to_announcements")
  // How many slots must be filled for the item to auto-complete.
  // null = all slots required (AND logic). Set to N for "any N of M" (OR logic).
  slotRequiredCount     Int?     @map("slot_required_count")
  slots       PhaseItemSlotDef[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("phase_item_definitions")
}

model PhaseGroupDefinition {
  id          String  @id @default(cuid())
  phase       Int
  groupKey    String  @unique
  label       String
  icon        String?
  description String?
  showTrainer Boolean @default(false)
  sortOrder   Int     @default(0)
  // Optional banner videos shown at the top of this step on the agent
  // dashboard. Same JSON shape as PhaseItemDefinition.videos:
  // [{ url: string, title: string|null }, ...]. Used for Melinee's
  // "Welcome to Step N" intro videos and any future per-step content.
  videos      Json    @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("phase_group_definitions")
}

// Slot template attached to a PhaseItemDefinition. Each slot is a named
// placeholder (e.g. "Business Partner 1") that an agent fills by linking
// a real record from their tracker. When all slots for an item are filled
// the parent PhaseItem auto-completes.
model PhaseItemSlotDef {
  id                    String               @id @default(cuid())
  phaseItemDefinitionId String
  phaseItemDefinition   PhaseItemDefinition  @relation(fields: [phaseItemDefinitionId], references: [id], onDelete: Cascade)
  label                 String               // e.g. "Business Partner 1"
  slotType              String               // 'business_partner' | 'field_appointment'
  sortOrder             Int                  @default(0)
  fulfillments          AgentSlotFulfillment[]
  createdAt             DateTime             @default(now())

  @@map("phase_item_slot_defs")
}

// Records which specific BP or FTA an agent used to fulfill a slot.
model AgentSlotFulfillment {
  id                String                    @id @default(cuid())
  slotDefId         String
  slotDef           PhaseItemSlotDef          @relation(fields: [slotDefId], references: [id], onDelete: Cascade)
  agentProfileId    String
  agentProfile      AgentProfile              @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  businessPartnerId String?
  businessPartner   BusinessPartner?          @relation(fields: [businessPartnerId], references: [id], onDelete: SetNull)
  ftaId             String?
  fta               FieldTrainingAppointment? @relation(fields: [ftaId], references: [id], onDelete: SetNull)
  fulfilledAt       DateTime                  @default(now())

  @@unique([slotDefId, agentProfileId])
  @@map("agent_slot_fulfillments")
}

model ProgressionDefinition {
  id          String  @id @default(cuid())
  key         String  @unique
  label       String
  description String
  icon        String?
  achievedWhen String
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("progression_definitions")
}

// DB-driven email templates fired by the GHL webhook. Each row ties a
// GHL event type ('AppointmentCreate', 'JoinFormSubmitted', etc.) to
// a sender + subject + WYSIWYG body. The webhook iterates every
// enabled template matching the inbound event, applies the row's
// filter (e.g. "only fire for prophog-tagged contacts"), substitutes
// {{variables}}, wraps the body in the AFF brand shell, and sends.
// See src/lib/email-template.ts + src/lib/email-template-send.ts.
model EmailTemplate {
  id          String  @id @default(cuid())
  key         String  @unique
  label       String
  description String?
  subject     String
  bodyHtml    String  @map("body_html") @db.Text
  // GHL event that triggers this template. Multiple templates can
  // share an eventType (e.g. one to the contact, one internal). Null
  // for legacy template rows that pre-date the webhook system.
  eventType   String? @map("event_type")
  // 'CONTACT' = send to the GHL contact in the inbound event.
  // 'INTERNAL' = send to internalTo (e.g. vick@allfinancialfreedom.com).
  recipient   String  @default("CONTACT")
  internalTo  String? @map("internal_to")
  // Optional filter: { tagStartsWith: 'prophog' }.
  filterJson  Json?   @map("filter_json")
  senderId    String? @map("sender_id")
  sender      EmailSender? @relation(fields: [senderId], references: [id])
  enabled     Boolean @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([eventType, enabled])
  @@map("email_templates")
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  message     String
  targetPhase Int?
  active      Boolean  @default(true)
  // When the announcement should start being visible to agents.
  // Null means "live as soon as it's created" (legacy behavior).
  // Set to a future date to schedule it ahead of time; the agent
  // GET endpoint filters out announcements where scheduledFor > now.
  scheduledFor DateTime?
  createdBy   String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  reads       AnnouncementRead[]

  @@map("announcements")
}

model AnnouncementRead {
  id              String       @id @default(cuid())
  announcementId  String
  announcement    Announcement @relation(fields: [announcementId], references: [id])
  agentProfileId  String
  agentProfile    AgentProfile @relation(fields: [agentProfileId], references: [id])
  readAt          DateTime     @default(now())

  @@unique([announcementId, agentProfileId])
  @@map("announcement_reads")
}

model AgentFeedback {
  id              String       @id @default(cuid())
  agentProfileId  String
  agentProfile    AgentProfile @relation(fields: [agentProfileId], references: [id])
  category        String       @default("general")
  message         String
  // Legacy read-flag, kept around so existing list filters keep working.
  // Auto-set to true the moment status moves off OPEN.
  read            Boolean      @default(false)
  // Workflow status. String (not enum) so future statuses don't need a
  // migration. Allowed values: OPEN | ACKNOWLEDGED | IN_PROGRESS | CLOSED.
  status          String       @default("OPEN")
  reviewedAt      DateTime?    // first time status moved off OPEN
  closedAt        DateTime?
  // Vercel Blob URLs for screenshots the agent attached when submitting
  // (or later edited in). Capped to 4 per ticket at the API layer; bare
  // string array since we never need to query individual rows. Frontend
  // renders as click-to-enlarge thumbnails on the agent + admin views.
  screenshotUrls  String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt @default(now())

  notes           AgentFeedbackNote[]

  @@map("agent_feedback")
}

// Threaded back-and-forth on a single AgentFeedback item. Replaces
// the original "single responseToAgent + single adminNotes" pattern
// with a real ticket conversation: admins post visible replies or
// internal-only notes, agents post clarification questions, both
// sides see chronological history. The legacy responseToAgent +
// adminNotes columns on AgentFeedback stay populated for a transition
// window and are seeded into this table by the migration.
model AgentFeedbackNote {
  id                   String         @id @default(cuid())
  feedbackId           String
  feedback             AgentFeedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  body                 String
  // true = admin/LC-only context, hidden from the agent.
  // Agent-authored notes are always isInternal=false.
  isInternal           Boolean        @default(false)
  // Exactly one author column is set per row. authorAdminId for admin/LC
  // posts, authorAgentProfileId for agent replies. SetNull on delete so
  // a deleted user doesn't take their old notes with them.
  authorAdminId        String?
  authorAdmin          AdminUser?     @relation(fields: [authorAdminId], references: [id], onDelete: SetNull)
  authorAgentProfileId String?
  authorAgentProfile   AgentProfile?  @relation(fields: [authorAgentProfileId], references: [id], onDelete: SetNull)
  createdAt            DateTime       @default(now())

  @@index([feedbackId, createdAt])
  @@map("agent_feedback_notes")
}

enum ReferralStatus {
