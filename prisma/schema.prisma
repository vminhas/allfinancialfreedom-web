  // for free-text notes and for the auto-generated New Business mirror
  // notes. Source of truth for grouping the daily digest by purpose.
  purpose        String?
  scope          NoteScope    @default(LICENSING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([agentProfileId, scope, createdAt])
  @@map("licensing_notes")
}

