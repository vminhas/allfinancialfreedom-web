enum LicensingRequestTopic {
  SCHEDULE_EXAM
  PASS_POST_LICENSING
  FINGERPRINTS_APPLY
  GFI_APPOINTMENTS
  CE_COURSES
  EO_INSURANCE
  DIRECT_DEPOSIT
  UNDERWRITING
  GENERAL
}

enum LicensingRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model CoordinatorRequest {
  id             String                 @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile           @relation(fields: [agentProfileId], references: [id])
  phaseItemKey   String?
  topic          LicensingRequestTopic
  message        String
  status         LicensingRequestStatus @default(OPEN)
  assignedToId   String?
  assignedTo     AdminUser?             @relation("AssignedCoordinator", fields: [assignedToId], references: [id])
  resolutionNote String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  resolvedAt     DateTime?
  // Threaded back-and-forth between the agent and the LC. The original
  // request body lives in `message` (one-shot from the agent at submit
  // time); subsequent replies in either direction land here so the LC
  // can send an interim "here's the link, schedule when you can" reply
  // without having to mark the request resolved.
  messages       CoordinatorMessage[]

  @@index([agentProfileId, status])
  @@index([status, assignedToId])
  @@map("coordinator_requests")
}

// One message in a coordinator-request thread. Separate from the parent
// request's `message` field (which is the original ask) so we have a
// clean append-only log of replies on both sides.
model CoordinatorMessage {
  id           String              @id @default(cuid())
  requestId    String
  request      CoordinatorRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // 'agent' | 'admin' | 'licensing_coordinator' - matches the role names
  // we use on the session.user.role. Stored as a string instead of an
  // enum so adding new sender types later doesn't require a migration.
  fromRole     String
  // FK to whichever user table the sender lives in. We don't add a
  // relation here because the sender could be either AgentProfile or
  // AdminUser; the role+id pair is enough to render attribution.
  fromUserId   String
  // Display name at send time so the thread renders without a join
  // even if the user's name later changes (or they're deactivated).
  fromName     String
  body         String
  createdAt    DateTime            @default(now())

  @@index([requestId, createdAt])
  @@map("coordinator_messages")
}

enum NoteScope {
  LICENSING   // visible to licensing coordinators AND admins
  ADMIN_ONLY  // visible to admins only — LC cannot see these
}

enum TrainingStreamType {
  GFI_LIVE
  ZOOM
}

model TrainingEvent {
  id                    String             @id @default(cuid())
  driveFileId           String?            // null for manually created events
  eventIndex            Int                @default(0)
  driveFileName         String?            // nullable (manual events have no Drive file)
  driveModifiedTime     DateTime?          // nullable
  driveThumbnailUrl     String?

  // Vercel Blob URL — reliable public CDN for Discord embeds.
  // Populated during sync (mirror from Drive) or on manual upload.
  flyerImageUrl         String?

  // Publish toggle — controls Discord scheduled event + T-15 reminders.
  // Default true so auto-synced events publish immediately.
  // Set false to suppress without deleting the row.
  published             Boolean            @default(true)

  title                 String
  subtitle              String?
  category              String?
  startsAt              DateTime           // canonical UTC
  durationMinutes       Int                @default(60)
  presenters            Json               // [{ name, role }]

  streamType            TrainingStreamType @default(GFI_LIVE)
  streamRoomName        String?
  streamId              String?
  passcode              String?

  audienceRestriction   String?
  partnerBrand          String?
  targetRegion          String?

  // Discord plumbing
  discordEventId        String?
  discordEventCreatedAt DateTime?
  reminderSentAt        DateTime?

  // Parse metadata (Drive-synced events only)
  parsedAt              DateTime           @default(now())
  parseError            String?
  rawParseJson          Json?
  modelId               String?
  inputTokens           Int                @default(0)
  outputTokens          Int                @default(0)

  // Manual override flag — admin edited the parsed values, don't re-overwrite
  manuallyEdited        Boolean            @default(false)

  // Recurrence — populated when the admin creates a recurring training. Each
  // occurrence is its own TrainingEvent row, linked back to the parent so we
  // can find siblings and roll forward more occurrences when the series is
  // running low. Self-relation: parent's recurrenceParentId is null and it
  // owns a children[] of upcoming + past instances.
  recurrenceParentId    String?
  recurrenceParent      TrainingEvent?     @relation("TrainingRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceChildren    TrainingEvent[]    @relation("TrainingRecurrence")
  recurrenceFrequency   String?            // 'WEEKLY' for now; future: DAILY / BIWEEKLY / MONTHLY

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // PostgreSQL allows multiple NULLs in unique constraints, so manual events
  // (driveFileId=null) won't conflict with each other.
  @@unique([driveFileId, eventIndex])
  @@index([startsAt])
  @@index([reminderSentAt])
  @@index([published, startsAt])
  @@index([recurrenceParentId])
  // Tracks the most recent Zoom attendance pull so the cron can skip
  // events it already synced. Null until the first sync runs.
  attendanceSyncedAt    DateTime?
  // Whether this event participates in the attendance grid + cron.
  // Default true so newly-parsed flyers are tracked by default;
  // admins flip this off for events they don't want surfaced (e.g.
  // Onboarding Academy, hierarchy calls, guest broadcasts that don't
  // happen on the AFF Zoom account).
  trackAttendance       Boolean   @default(true)
  attendances           TrainingAttendance[]
  attendanceOrphans     TrainingAttendanceOrphan[]
  @@map("training_events")
}

// Per-(training, agent) attendance row. We keep one row per active
// agent per ZOOM-streamed training so the grid view can render dense
// without extra joins. Computed status is filled by the Zoom sync;
// admins can override via manualStatus to Excuse / Not Tracking.
model TrainingAttendance {
  id                String                   @id @default(cuid())
  trainingEventId   String
  trainingEvent     TrainingEvent            @relation(fields: [trainingEventId], references: [id], onDelete: Cascade)
  agentProfileId    String
  agentProfile      AgentProfile             @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)

  // Effective status surfaced in the grid. Equals manualStatus when the
  // admin has overridden, otherwise mirrors the Zoom-derived value.
  status            TrainingAttendanceStatus
  // Admin override; null means "use the auto-computed status."
  manualStatus      TrainingAttendanceStatus?
  manualNote        String?

  // Raw Zoom data — useful for audit when Vick wants to see why
  // someone got marked Absent or Present.
  zoomDisplayName   String?
  zoomEmail         String?
  zoomUserId        String?
  joinedAt          DateTime?
  leftAt            DateTime?
  durationSeconds   Int?

  source            String                   @default("zoom")  // 'zoom' | 'manual' | 'backfill'
  syncedAt          DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([trainingEventId, agentProfileId])
  @@index([trainingEventId, status])
  @@index([agentProfileId, status])
  @@map("training_attendances")
}

// Agents who are no longer attending trainings (left the team,
// permanent leave). Every training auto-renders them red /
// NOT_TRACKING in the attendance grid so the admin doesn't have to
// mark them absent meeting after meeting. An explicit per-event
// manualStatus override still wins if they ever do show up.
model TrainingAttendanceExclusion {
  id             String       @id @default(cuid())
  agentProfileId String       @unique @map("agent_profile_id")
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  reason         String?
  createdBy      String?      @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([agentProfileId])
  @@map("training_attendance_exclusions")
}

// Zoom participants we couldn't match to an AgentProfile by email or
// fuzzy name. Admin resolves them in a queue; resolution writes a real
// TrainingAttendance row and deletes the orphan. Kept in its own table
// so the dense grid query stays fast.
model TrainingAttendanceOrphan {
  id                String        @id @default(cuid())
  trainingEventId   String
  trainingEvent     TrainingEvent @relation(fields: [trainingEventId], references: [id], onDelete: Cascade)

  zoomDisplayName   String
  zoomEmail         String?
  zoomUserId        String?
  joinedAt          DateTime
  durationSeconds   Int

  // When the admin maps this orphan to an agent we keep the link in
  // case we want to remember the Zoom alias for next time. Once
  // resolved we also write the corresponding TrainingAttendance row.
  resolvedAgentId   String?
  resolvedAgent     AgentProfile? @relation("OrphanResolved", fields: [resolvedAgentId], references: [id], onDelete: SetNull)
  resolvedAt        DateTime?

  createdAt         DateTime      @default(now())

  @@index([trainingEventId])
  @@index([resolvedAt])
  @@map("training_attendance_orphans")
}

enum TrainingAttendanceStatus {
  PRESENT
